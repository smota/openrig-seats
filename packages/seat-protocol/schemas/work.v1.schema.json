{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smota.github.io/openrig-seats/schemas/work.v1.schema.json",
  "title": "Seat protocol v1: work",
  "description": "A unit of work routed to or between seats (a queue item, a task).",
  "allOf": [{ "$ref": "common.v1.schema.json#/$defs/entity" }],
  "type": "object",
  "required": ["id", "updatedAt", "title", "state"],
  "properties": {
    "state": { "enum": ["pending", "in-progress", "blocked", "done", "failed", "cancelled"] },
    "assigneeSeatId": { "$ref": "common.v1.schema.json#/$defs/id" },
    "creatorSeatId": { "$ref": "common.v1.schema.json#/$defs/id" },
    "waitingOnHuman": { "type": "boolean" },
    "createdAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" }
  }
}
