{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smota.github.io/openrig-seats/schemas/host.v1.schema.json",
  "title": "Seat protocol v1: host",
  "allOf": [{ "$ref": "common.v1.schema.json#/$defs/entity" }],
  "type": "object",
  "required": ["id", "updatedAt", "name", "state"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "state": { "enum": ["online", "degraded", "offline", "unknown"] },
    "version": { "type": "string" }
  }
}
