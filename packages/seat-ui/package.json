{
  "name": "@openrig-seats/seat-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Protocol-driven reference seat web UI",
  "scripts": {
    "prebuild": "npm run build -w @openrig-seats/seat-protocol",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "start": "node server.mjs",
    "pretest": "npm run build -w @openrig-seats/seat-protocol",
    "test": "vitest run",
    "check": "npm run build -w @openrig-seats/seat-protocol && tsc --noEmit && node --check server.mjs"
  },
  "dependencies": {
    "@openrig-seats/seat-protocol": "*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.7",
    "vitest": "^3.0.0"
  }
}
