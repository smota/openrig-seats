{
  "name": "openrig-seats",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @openrig-seats/seat-protocol && npm run build -w @openrig-seats/seat-source-openrig && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "generate": "npm run generate --workspaces --if-present"
  },
  "engines": {
    "node": "^22 || ^24",
    "npm": ">=10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
